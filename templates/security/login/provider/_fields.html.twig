{% if context.displayTrustedOption|default(false) %}
    <div class="form-check mb-3">
        <input class="form-check-input" type="checkbox" id="_trusted" name="{{ context.trustedParameterName }}">
        <label class="form-check-label" for="_trusted">{{ 'trusted'|trans({}, 'SchebTwoFactorBundle') }}</label>
    </div>
{% endif %}
{% if context.isCsrfProtectionEnabled|default(false) %}
    <input type="hidden" name="{{ context.csrfParameterName }}" value="{{ csrf_token(context.csrfTokenId) }}">
{% endif %}
